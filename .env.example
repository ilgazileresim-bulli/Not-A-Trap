# Yerel geliştirme
NAT_TRAP_HOST=127.0.0.1
NAT_TRAP_PORT=8765

# Üretimde bu değeri 86400 olarak bırakın: tam 24 saat.
NAT_TRAP_APPROVAL_DELAY_SECONDS=86400
NAT_TRAP_MAX_UPLOAD_BYTES=33554432

# İnsan moderasyon API'si için uzun, rastgele bir anahtar.
NAT_TRAP_ADMIN_KEY=change-this-to-a-long-random-secret

# İsteğe bağlı antivirüs komutu. {file} otomatik olarak karantina yoluyla değiştirilir.
# NAT_TRAP_SCANNER_COMMAND=clamscan --no-summary {file}
